; Engine configuration file.
; Godot writes extra settings here when the project is opened in the editor; that's fine to commit.

config_version=5

[application]

config/name="Uzay"
config/description="True-scale space exploration: the Solar System, nearby stars and Sagittarius A*."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Universe="*res://src/sim/universe.gd"
GameInput="*res://src/core/game_input.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

environment/defaults/default_clear_color=Color(0, 0, 0, 1)
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/tighter_shadow_caster_culling=false
